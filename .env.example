# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:8080"

# ---------------------------------------------------------------------------
# Data store: postgres (local Docker / Aurora path) or json (legacy file)
# ---------------------------------------------------------------------------
PIXBE_STORE=postgres
PIXBE_AUTO_IMPORT_JSON=true

# Local Postgres (docker compose up -d db)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
ADMIN_DB_NAME=postgres
CONTROL_DB_NAME=pixbe_control

# AWS RDS PostgreSQL (ap-south-1). Used instead of DB_* when AWS_RDS_HOST is set.
# Also set ADMIN_DB_NAME to the same value as AWS_RDS_DATABASE.
# AWS_RDS_HOST=
# AWS_RDS_PORT=5432
# AWS_RDS_DATABASE=crmdatabase
# AWS_RDS_USER=postgres
# AWS_RDS_PASSWORD=
# AWS_RDS_SSL=true
# AWS_REGION=ap-south-1

# ---------------------------------------------------------------------------
# AWS S3 — recordings, excel imports, attachments (wire up with mobile app)
# On ECS use task role IAM; do not rely on long-lived keys in production.
# ---------------------------------------------------------------------------
# AWS_S3_BUCKET=crm-media-YOUR_ACCOUNT-ap-south-1-an
# AWS_S3_REGION=ap-south-1
# AWS_S3_RECORDINGS_PREFIX=recordings/
# AWS_S3_EXCEL_PREFIX=excel/
# AWS_S3_ATTACHMENTS_PREFIX=attachments/

# ---------------------------------------------------------------------------
# Amazon Cognito (ap-south-1) — when set, login/signup use Cognito
# App client MUST enable ALLOW_USER_PASSWORD_AUTH + ALLOW_REFRESH_TOKEN_AUTH
# If the app client has a client secret, set COGNITO_CLIENT_SECRET (required for SECRET_HASH)
# Server IAM/credentials need: cognito-idp:AdminCreateUser, AdminSetUserPassword, AdminGetUser,
# ForgotPassword, ConfirmForgotPassword (admin password change from Settings → Security)
# (used when Admin creates team users in Users & Team)
#
# Forgot-password email template (Cognito User Pool → Messaging):
#   Subject: Reset your Pixbe password
#   Body: Open this link to set a new password:
#         {APP_URL}/set-password?email={username}&code={####}
# Replace {APP_URL} with your public URL (e.g. https://senate-appetizer-crock.ngrok-free.dev).
# Without this template Cognito still emails a code; /set-password accepts a pasted code.
# ---------------------------------------------------------------------------
COGNITO_REGION=ap-south-1
COGNITO_CLIENT_ID=your_cognito_app_client_id
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXX
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=https://your-prefix.auth.ap-south-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:8080/
# ALLOW_LEGACY_ADMIN=false
# Required when ALLOW_LEGACY_ADMIN=true (or Cognito off). Do not use weak defaults in production.
# LEGACY_ADMIN_PASSWORD=

# META LEAD ADS WEBHOOK CONFIGURATION
PORT=8080
META_VERIFY_TOKEN="your_meta_verify_token"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="your_meta_verify_token"
META_APP_ID="your_meta_app_id"
META_PAGE_ID="your_meta_page_id"
META_PAGE_ACCESS_TOKEN="your_meta_page_access_token"
# Optional override; otherwise derived from APP_URL
# META_REDIRECT_URI=https://your-domain/api/integrations/facebook/callback
