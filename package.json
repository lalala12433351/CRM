{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node -e \"console.log('Prebuilt bundle ready')\"",
    "build:local": "vite build --configLoader runner && vite build --ssr server.ts --configLoader runner --outDir dist --emptyOutDir false && node scripts/copy-store-to-dist.cjs",
    "build:docker": "vite build --configLoader runner && vite build --ssr server.ts --configLoader runner --outDir dist --emptyOutDir false && node scripts/copy-store-to-dist.cjs",
    "build:mobile": "vite build --mode mobile --configLoader runner",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "bundle": "npm run build:local && python create_deploy_zip.py",
    "copy-store": "node scripts/copy-store-to-dist.cjs",
    "start": "node dist/server.js",
    "start:meta": "node server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "docker:build": "docker build -t pixbe-crm:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "db:up": "docker compose --profile local-db up -d db",
    "db:import": "tsx scripts/import_json_to_postgres.ts",
    "db:bootstrap": "tsx -e \"import('dotenv/config'); import('./server/db/bootstrap.ts').then(m => m.bootstrapPostgres().then(r => { console.log(r); return m.closeAllPools(); }))\""
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1137.0",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/rds-signer": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@xyflow/react": "^12.11.6",
    "aws-jwt-verify": "^5.2.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "localtunnel": "^2.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
