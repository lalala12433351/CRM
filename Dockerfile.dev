# ==============================================================================
# Pixbe CRM - Development Dockerfile
# Supports live volume mounting and hot module reloading (HMR)
# ==============================================================================

FROM node:20-alpine

WORKDIR /app

# Install libc compatibility
RUN apk add --no-cache libc6-compat

# Copy package manifests
COPY package.json package-lock.json* ./

# Install all dependencies
RUN npm install

# Copy project files
COPY . .

# Set development environment
ENV NODE_ENV=development
ENV PORT=8080

EXPOSE 8080

# Run in live development mode with tsx server.ts
CMD ["npm", "run", "dev"]
